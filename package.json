{
  "name": "live-board",
  "version": "1.0.0",
  "description": "Real-time kanban board: WebSocket sync with a server-ordered op log, optimistic updates with rebase, presence, fractional ranks, reconnect catch-up.",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "server": "node server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.11.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
